# ==== SUNUCU ====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==== VERİTABANI ====
# Örnek: postgresql://kullanici:sifre@localhost:5432/fen_platformu?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fen_platformu?schema=public"

# ==== JWT ====
JWT_ACCESS_SECRET="değiştir-bu-cok-gizli-erisim-anahtari"
JWT_REFRESH_SECRET="değiştir-bu-cok-gizli-yenileme-anahtari"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==== ŞİFRE SIFIRLAMA ====
RESET_PASSWORD_TOKEN_EXPIRES_MIN=30

# ==== RATE LIMIT ====
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100

# ==== AŞAMA 5: YAPAY ZEKÂ DESTEKLİ YARDIMCI ====
# Opsiyonel: Tanımlanırsa AI Asistan gerçek bir Claude modeliyle yanıt üretir.
# Tanımlanmazsa kural tabanlı (rule-based) yedek moda otomatik geçilir; özellik
# API anahtarı olmadan da eksiksiz çalışır.
ANTHROPIC_API_KEY=""
